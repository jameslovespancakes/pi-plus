{
  "env": {
    "ARTIFICIAL_ANALYSIS_API_KEY": "<artificial-analysis-api-key>",
    "AGENT_BOARD_URL": "ws://<board-host>:8787/ws",
    "AGENT_BOARD_TOKEN": "<agent-board-token>",
    "AGENT_BOARD_NAME": "you"
  },
  "policy": {
    "autoApprove": [
      "anthropic/*",
      "openai-codex/*",
      "kimi-coding/*",
      "xai/*",
      "openrouter/stealth/union-alpha"
    ],
    "requireApproval": [
      "openrouter/*",
      "google/*",
      "openai/*"
    ],
    "deny": []
  },
  "remote": {
    "injectStatus": true,
    "defaults": {
      "cpuBlockPercent": 90,
      "gpuBlockPercent": 90,
      "gpuMemoryBlockPercent": 90,
      "memoryBlockPercent": 90,
      "minimumFreeDiskGB": 10,
      "statusCacheSeconds": 30,
      "retentionHours": 24
    },
    "workers": [
      {
        "name": "mac-box",
        "ssh": "mac-box",
        "root": "~/remote_tests",
        "nice": 10,
        "tags": [
          "macos",
          "arm64",
          "gpu",
          "metal"
        ]
      },
      {
        "name": "linux-box",
        "ssh": "linux-box",
        "root": "~/remote_tests",
        "nice": 10,
        "tags": [
          "linux",
          "x64",
          "gpu",
          "cuda"
        ]
      }
    ]
  }
}
